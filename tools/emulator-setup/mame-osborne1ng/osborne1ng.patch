+++ b/src/devices/machine/acb4000_host_adapter.cpp
@@ -0,0 +1,415 @@
+// license:BSD-3-Clause
+// copyright-holders:James Arlen
+/***************************************************************************
+
+    Adaptec ACB-4000 host adapter -- the Z80-side card
+
+    See acb4000_host_adapter.h for the register map.  The transaction
+    routine this answers is the MD-10 BIOS overlay's own code, at
+    HARDBIOS.SPR file offset 0x285 (address 0xE285):
+
+        e285  ld (0172h),hl      ; save the host buffer pointer
+        e288  ld (01fah),a       ; the opcode, and so the CDB at 01fah..
+        e28b  in a,(032h)        ; wait for the select handshake to clear
+              and 001h
+              jr nz,e28b
+        e291  ld a,(00557h)      ; the select byte
+              out (030h),a
+        e296  ld a,010h
+              out (032h),a       ; assert the handshake
+        e29a  in a,(032h)        ; ... and wait for the card to answer
+              and 001h
+              jr z,e29a
+        e2a0  xor a
+              out (032h),a       ; release it -- the command phase starts
+              ld hl,01fah
+              ld c,030h
+        e2a8  in a,(032h)        ; command phase: REQ + phase -> send a byte
+              bit 6,a
+              jr nz,e2ba
+              bit 1,a
+              jr z,e2a8
+              and 020h
+              jr z,e2ba
+              outi
+              jr e2a8
+        e2ba  ld b,000h          ; data phase: 512 bytes per pass
+              ld hl,(0172h)
+        e2bf  in a,(032h)
+              bit 6,a
+              jr nz,e2cf
+              and 002h
+              jr z,e2bf
+              otir
+              otir
+              jr e2bf
+        e2cf  and 020h           ; phase over: status, or read the data in
+              jr nz,e2e6
+              ld a,(01fah)
+              cp 008h
+              jr z,e2f4          ; READ -> 2 x INIR = 512 bytes
+        e2da  ini                ; ... otherwise a byte at a time
+        e2dc  in a,(032h)
+              bit 6,a
+              jr z,e2dc
+              and 020h
+              jr z,e2da
+        e2e6  in b,(c)           ; the status byte
+        e2e8  in a,(032h)
+              and 040h
+              jr z,e2e8
+        e2ee  in a,(030h)        ; discard
+              ld a,b
+              and 002h           ; 0 = good, 2 = check condition
+              ret
+
+    So the card has to present four states and the driver's own loops do the
+    rest: the command phase moves one CDB byte per REQ, the data phase moves
+    512-byte blocks, and the status phase hands over one status byte.
+
+***************************************************************************/
+
+#include "emu.h"
+#include "acb4000_host_adapter.h"
+
+#include "machine/t10spc.h"
+
+#include <iterator>
+
+
+// device type definition
+DEFINE_DEVICE_TYPE(ACB4000_HOST_ADAPTER, acb4000_host_adapter_device, "acb4000ha", "Adaptec ACB-4000 host adapter")
+
+// The controller answers as Adaptec's "controller 01", i.e. select byte 01h --
+// which is SCSI ID 0.  HARD.COM's own probe reads its select byte from a
+// configured byte (0x0A93) rather than scanning, and that byte is 01h
+// (docs/osborne1ng-machine.md).
+static constexpr u8 ACB4000_SCSI_ID = 0;
+
+// the driver moves data in 512-byte blocks (2 x OTIR/INIR with B = 0)
+static constexpr int BLOCK_SIZE = 512;
+
+
+acb4000_host_adapter_device::acb4000_host_adapter_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock)
+	: legacy_scsi_host_adapter(mconfig, ACB4000_HOST_ADAPTER, tag, owner, clock)
+	, m_target_id(ACB4000_SCSI_ID)
+	, m_reg1(0)
+	, m_reg3(0)
+	, m_select(0)
+	, m_last_read(0)
+	, m_xfer(xfer::idle)
+	, m_cdb_index(0)
+	, m_cdb_length(0)
+	, m_buffer_count(0)
+	, m_buffer_index(0)
+	, m_transferred(0)
+	, m_total(0)
+	, m_online(false)
+{
+}
+
+void acb4000_host_adapter_device::device_start()
+{
+	legacy_scsi_host_adapter::device_start();
+
+	save_item(NAME(m_reg1));
+	save_item(NAME(m_reg2));
+	save_item(NAME(m_reg3));
+	save_item(NAME(m_select));
+	save_item(NAME(m_last_read));
+	save_item(NAME(m_cdb));
+	save_item(NAME(m_cdb_index));
+	save_item(NAME(m_cdb_length));
+	save_item(NAME(m_buffer));
+	save_item(NAME(m_buffer_count));
+	save_item(NAME(m_buffer_index));
+	save_item(NAME(m_transferred));
+	save_item(NAME(m_total));
+	save_item(NAME(m_online));
+}
+
+void acb4000_host_adapter_device::device_reset()
+{
+	legacy_scsi_host_adapter::device_reset();
+
+	m_reg1 = m_reg3 = 0;
+	m_select = 0;
+	m_last_read = 0;
+	m_xfer = xfer::idle;
+	m_cdb_index = m_cdb_length = 0;
+	m_buffer_count = m_buffer_index = 0;
+	m_transferred = m_total = 0;
+
+	// "one controller on-line" is a property of the card, not of a register
+	// the host writes: the presence probe writes 04h to base+2 and reads the
+	// on-line bit back out of the status byte (docs/acb4000-host-adapter.md 1).
+	m_online = select(m_target_id);
+	if (!m_online)
+	{
+		for (int i = 0; 8 > i; ++i)
+			if (select(i))
+				logerror("a target answers at SCSI id %d, but the card is looking for %d\n", i, m_target_id);
+	}
+
+	// base+2 is a read/write register, and its controller field reflects what is
+	// fitted: one controller on-line reads back as 04h (docs/osborne1ng-machine.md).
+	m_reg2 = m_online ? STATUS_ONLINE : 0x00;
+}
+
+// SCSI CDB length from the group code in the opcode's top three bits
+int acb4000_host_adapter_device::cdb_length(u8 opcode)
+{
+	switch ((opcode >> 5) & 0x07)
+	{
+	case 0:  return 6;
+	case 1:
+	case 2:  return 10;
+	case 3:  return 12;
+	case 4:  return 16;
+	case 5:  return 12;
+	default: return 6;
+	}
+}
+
+bool acb4000_host_adapter_device::select_target()
+{
+	// The host writes a one-of-eight ID mask to base+0 before asserting the
+	// select bit; the overlay scans the mask with `sla c` from 01h, so that is
+	// the encoding (docs/osborne1ng-machine.md).
+	int id = -1;
+	for (int i = 0; (8 > i) && (0 > id); ++i)
+		if (BIT(m_select, i))
+			id = i;
+
+	logerror("select byte %02X\n", m_select);
+
+	// strict: the card answers only at the ID the host selected
+	return (0 <= id) && select(id);
+}
+
+void acb4000_host_adapter_device::start_command()
+{
+	select_target();
+	send_command(m_cdb, m_cdb_length);
+
+	m_total = get_length();
+	logerror("CDB %02X %02X %02X %02X %02X %02X -> phase %d, %u bytes\n",
+			m_cdb[0], m_cdb[1], m_cdb[2], m_cdb[3], m_cdb[4], m_cdb[5], get_phase(), m_total);
+
+	switch (get_phase())
+	{
+	case SCSI_PHASE_DATAIN:  begin_data(true);  break;
+	case SCSI_PHASE_DATAOUT: begin_data(false); break;
+	default:                 begin_status();    break;
+	}
+}
+
+void acb4000_host_adapter_device::begin_data(bool data_in)
+{
+	m_xfer = data_in ? xfer::data_in : xfer::data_out;
+	m_transferred = 0;
+	m_buffer_index = 0;
+	m_buffer_count = 0;
+
+	// a target may answer with a zero-length transfer (TEST UNIT READY, SEEK,
+	// FORMAT ...) -- there is no data phase, go straight to status
+	if (!m_total)
+	{
+		begin_status();
+		return;
+	}
+
+	if (data_in)
+	{
+		m_buffer_count = BLOCK_SIZE;
+		read_data(m_buffer, BLOCK_SIZE);
+	}
+}
+
+void acb4000_host_adapter_device::begin_status()
+{
+	m_xfer = xfer::status;
+	m_buffer_index = 0;
+	m_buffer_count = 0;
+}
+
+u8 acb4000_host_adapter_device::read_data_byte()
+{
+	if (xfer::data_in != m_xfer)
+	{
+		// status phase: the status byte stays on the data register until the
+		// driver has taken it twice.  Its routine reads it into B (`in b,(c)`,
+		// l80c4) and then reads the register again to acknowledge (l80cc);
+		// a byte-at-a-time data-in transfer reads it once more, because its
+		// loop takes a byte before it notices the phase has changed (l80b8).
+		// The status has to survive those reads for the check the routine ends
+		// on (`and 002h`) to see the real status and not a stale zero.
+		if (xfer::status == m_xfer)
+		{
+			if (2 > m_buffer_index)
+			{
+				m_buffer_index++;
+				m_last_read = get_status();
+				return m_last_read;
+			}
+			m_xfer = xfer::idle;
+			m_last_read = 0;
+			return m_last_read;
+		}
+		m_last_read = 0;
+		return m_last_read;
+	}
+
+	m_last_read = m_buffer[m_buffer_index++];
+
+	// A 512-byte block boundary, or the end of a short transfer -- whichever
+	// comes first.  The driver's own loops say which is which: a READ moves 512
+	// bytes per pass (2 x INIR with B = 0) and relies on the phase changing to
+	// stop, while every other opcode -- MODE SENSE, READ CAPACITY, INQUIRY --
+	// moves one byte at a time until the phase changes.  Ending at
+	// min(block, total) satisfies both: the MD-10 issues READ as a whole number
+	// of blocks, and a short transfer ends where the target said it would.
+	if ((BLOCK_SIZE <= m_buffer_index) || (m_transferred + m_buffer_index >= m_total))
+	{
+		m_transferred += m_buffer_index;
+		m_buffer_index = 0;
+		if (m_transferred >= m_total)
+			begin_status();
+		else
+		{
+			m_buffer_count = BLOCK_SIZE;
+			read_data(m_buffer, BLOCK_SIZE);
+		}
+	}
+	return m_last_read;
+}
+
+void acb4000_host_adapter_device::write_data_byte(u8 data)
+{
+	if (xfer::data_out != m_xfer)
+		return;
+
+	m_buffer[m_buffer_index++] = data;
+
+	// ... and the same rule in the other direction (see read_data_byte)
+	if ((BLOCK_SIZE <= m_buffer_index) || (m_transferred + m_buffer_index >= m_total))
+	{
+		write_data(m_buffer, m_buffer_index);
+		m_transferred += m_buffer_index;
+		m_buffer_index = 0;
+		if (m_transferred >= m_total)
+			begin_status();
+	}
+}
+
+u8 acb4000_host_adapter_device::status_bits() const
+{
+	// base+2 is a read/write register: the host writes a controller-select byte
+	// and reads it back.  Its controller field only reads back when a controller
+	// is actually on-line, which is what makes the presence probe a probe and
+	// not an echo (docs/osborne1ng-machine.md).
+	u8 st = m_reg2;
+	if (!m_online)
+		st &= ~STATUS_ONLINE;
+
+	// ... and the card drives the handshake and transfer bits on top of it.
+	// The status phase deliberately does *not* assert REQ: the driver's
+	// data-out loop writes a byte for every REQ it sees (l808d), so a REQ left
+	// up while the status byte is waiting would have it write for ever.  The
+	// status phase is announced by PHASE + END, which is what both the
+	// block and the byte-at-a-time paths test for (l80a5).
+	switch (m_xfer)
+	{
+	case xfer::idle:      break;
+	case xfer::selected:  st |= STATUS_SELECT;                            break;
+	case xfer::command:   st |= STATUS_REQ | STATUS_PHASE;                break;
+	case xfer::data_in:   st |= STATUS_REQ | STATUS_END;                  break;
+	case xfer::data_out:  st |= STATUS_REQ;                               break;
+	case xfer::status:    st |= STATUS_PHASE | STATUS_END;                break;
+	}
+
+	return st;
+}
+
+u8 acb4000_host_adapter_device::read(offs_t offset)
+{
+	switch (offset & 0x03)
+	{
+	case 0x00:  // data -- and the block port the OUTI/INI/OTIR/INIR loops use
+		return read_data_byte();
+
+	case 0x02:  // status
+		return status_bits();
+
+	default:
+		return 0xff;
+	}
+}
+
+void acb4000_host_adapter_device::write(offs_t offset, u8 data)
+{
+	switch (offset & 0x03)
+	{
+	case 0x00:  // data
+		switch (m_xfer)
+		{
+		case xfer::idle:
+		case xfer::status:
+			// The select byte can arrive at any time the card is not in the
+			// middle of a command -- including while the previous command's
+			// status byte is still up, which is what the overlay's ID scan does
+			// (it selects, looks, and selects the next candidate without the
+			// status ever being acknowledged).  Dropping it here would leave
+			// the *previous* select byte in place and make every candidate
+			// answer.
+			m_select = data;
+			break;
+		case xfer::command:                                  // one CDB byte
+			if (0 == m_cdb_index)
+				m_cdb_length = cdb_length(data);
+			if (m_cdb_index < std::size(m_cdb))
+				m_cdb[m_cdb_index] = data;
+			m_cdb_index++;
+			if (m_cdb_index >= m_cdb_length)
+				start_command();
+			break;
+		case xfer::data_out:
+			write_data_byte(data);
+			break;
+		default:
+			break;
+		}
+		break;
+
+	case 0x01:  // control
+		m_reg1 = data;
+		break;
+
+	case 0x02:  // status (read) / control (write)
+		m_reg2 = data;
+		if (CTRL_SELECT == data)
+		{
+			// select: only a controller that actually answers raises bit 0, and
+			// that is what the overlay's ID scan (sla c from 01h) is looking for
+			if (select_target())
+				m_xfer = xfer::selected;
+		}
+		else if ((0 == data) && (xfer::selected == m_xfer))
+		{
+			// The command phase starts here, and it starts *fresh*: the driver
+			// re-selects and re-enters the routine for every command (the
+			// overlay's transaction at 0x8030 / the BIOS's at 0xE285), so a CDB
+			// index left over from the previous command must not be carried into
+			// this one.  Without this the second and later commands send one byte
+			// and the card re-runs the stale CDB (docs/osborne1ng-machine.md).
+			m_cdb_index = 0;
+			m_cdb_length = 0;
+			m_xfer = xfer::command;
+		}
+		break;
+
+	case 0x03:  // control
+		m_reg3 = data;
+		break;
+	}
+}
