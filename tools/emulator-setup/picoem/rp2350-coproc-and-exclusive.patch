     // CP4/5 DCP CDP: all arithmetic, compare, convert, status ops.
     fn encode_cdp_dcp(opc1: u8, crn: u8, crd: u8, op2: u8, crm: u8) -> (u16, u16) {
         // CDP: bit 4 of hw1 must be 0.
