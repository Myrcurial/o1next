+// license:BSD-3-Clause
+// copyright-holders:James Arlen
+/***************************************************************************
+
+    softROM -- the ROM window, the frame slot, and the ROM service's door
+
+    The interposer sits on the Z80 bus and presents the ROM window itself, so
+    the machine's ROM is an image in flash rather than a part in the socket
+    (docs/o1-rom-2.0.md sections 4.1 and 4.1b).  This file is that window, the
+    slot the boot frame is mounted in, and the register pair the ROM asks for
+    either of them through (docs/rom-pico-protocol.md sections 2-5).
+
+    THE WINDOW.  8 KB -- 0000-1FFF -- because the mainboard never decoded A12.
+    MAME's own map for the stock machine says so in one line:
+
+        m_rom_view[0](0x0000, 0x0fff).mirror(0x1000).rom()...
+
+    `mirror(0x1000)` *is* the undecoded A12: the 4 KB monitor appears twice
+    across the window.  Decoding it gives two contiguous 4 KB pages:
+
+        0000-0FFF   page 0   the monitor -- the 4 KB that must never move
+        1000-1FFF   page 1   the payload, or one half of the boot frame
+
+    An image of 4 KB or less *is* the stock part and mirrors; a larger one gives
+    both pages.  With no image mounted the window serves the machine's own ROM
+    region, so an image-less machine boots exactly as the stock one does -- the
+    acceptance that proves the plumbing before any monitor code exists.  Past
+    the end of an image the window reads 0xFF, which is what erased flash
+    answers.
+
+    PAGE 1'S SELECTOR.  The boot screen is not the payload.  The O1's video cell
+    is nine bits -- eight of character, one of brightness -- and the ninth is not
+    in the video RAM, so the frame is *two* 4096-byte halves, characters and
+    attributes, and each is a window page in its turn.  `PRESENT(id)` selects:
+    0 the payload, 1 the frame's character half, 2 its attribute half, 3 the
+    boot splash.  v1.0's attribute half is all 0xFF -- every cell bright --
+    because bit 7 set is bright and that is what the array reads back, its low
+    seven bits not being physically present.
+
+    AND THE BOOT SPLASH IS AN ASSET OF ITS OWN, not a third page of one.  It is
+    the *code* the monitor runs to draw the screen, and it does not fit the
+    monitor's tail -- 183 bytes against the 72 that were free -- so the monitor
+    keeps a ~30-byte stub that asks for it with `PRESENT(3)`, copies page 1 to RAM
+    at 4000h and jumps (docs/o1-rom-2.0.md 4.7).  It is an asset rather than a page
+    because page 1 is where the frame goes.
+
+    THE DOOR.  A bank-2 register pair the machine maps.  The machine owns the
+    address -- osborne1.cpp's DOOR_BASE note says which and why, and it is a
+    measurement rather than a preference -- and this owns the transaction:
+
+        write  the request: opcode, then its operands, one byte at a time
+        read   the reply: 0 = not ready, else the length, then the bytes
+
+    The transaction, the result codes and the recovery rule are the mailbox
+    protocol's (docs/mailbox-protocol.md section 3): same opcodes, same replies,
+    same behaviour, so a firmware that implements one implements both.  The one
+    command the screen needs is `PRESENT`.
+
+    Each image is named on the machine's own command line, after its device's tag:
+
+        mame osborne1nx -softrom rom2.rom -frame frame.bin -bootsplash screen.bin
+
+    `-bootsplash` and not `-screen`: an image device's command-line option is named
+    after its image *type* and its slot after its tag, and `screen` is taken for
+    both -- by MAME's own display option, and by the machine's video screen.  The
+    file it mounts is `firmware/rom-service/screen.bin`, because the asset *is* the
+    screen's code; the splash is what that code draws.
+
+***************************************************************************/
+
+#ifndef MAME_MACHINE_SOFTROM_H
+#define MAME_MACHINE_SOFTROM_H
+
+#pragma once
+
+#include <vector>
+
+
+// THE INTERPOSER'S FLASH ASSETS.  Each is mounted from its own file, and each is
+// a device of its own rather than a second image on the window device --
+// device_image_interface is one image per device, and they are mounted and
+// swapped separately, which is what lets the harness run with a frame, a corrupt
+// frame, and no frame at all (docs/rom-pico-protocol.md section 5).
+//
+// ONE CLASS, because loading an asset is the same act twice: refuse anything that
+// is not the size it has to be, read it, and answer 0xFF past its end.  What
+// differs is *how much* an asset is and what it is called, and that is the whole
+// of what the subclasses below add -- a third near-copy of the loader is the
+// thing this shape exists to avoid.
+class o1asset_device : public device_t, public device_image_interface
+{
+public:
+	o1asset_device(const machine_config &mconfig, device_type type, const char *tag, device_t *owner, u32 clock = 0);
+
+	bool mounted() const { return !m_data.empty(); }
+	const std::vector<u8> &data() const { return m_data; }
+
+	// How many bytes this asset is, exactly, and what to say when a file is the
+	// wrong size.  Neither is negotiable and both are the subclass's, which is the
+	// only thing a subclass here has to say: the description is the whole of the
+	// sentence up to the sizes, so that the refusal names what was expected.
+	virtual u32 asset_size() const noexcept = 0;
+	virtual const char *asset_description() const noexcept = 0;
+
+protected:
+	// device_t
+	virtual void device_start() override ATTR_COLD;
+
+	// device_image_interface
+	virtual std::pair<std::error_condition, std::string> call_load() override;
+	virtual void call_unload() override;
+	virtual bool is_readable() const noexcept override { return true; }
+	virtual bool is_writeable() const noexcept override { return false; }
+	virtual bool is_creatable() const noexcept override { return false; }
+	virtual bool is_reset_on_load() const noexcept override { return true; }
+	virtual const char *file_extensions() const noexcept override { return "bin,rom"; }
+
+private:
+	std::vector<u8> m_data;
+};
+
+
+// the boot frame: the screen's 4096-byte character half, then its attribute half
+class o1frame_device : public o1asset_device
+{
+public:
+	o1frame_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock = 0);
+
+	static constexpr u32 FRAME_SIZE = 0x2000;
+
+	virtual u32 asset_size() const noexcept override { return FRAME_SIZE; }
+	virtual const char *asset_description() const noexcept override { return "a frame is two 4096-byte halves"; }
+	virtual const char *image_type_name() const noexcept override { return "frame"; }
+	virtual const char *image_brief_type_name() const noexcept override { return "frame"; }
+};
+
+
+// The boot splash: the code the monitor's stub asks for with PRESENT(3), copies to
+// RAM at 4000h and jumps into.  One window page, because that is what the stub
+// copies (docs/o1-rom-2.0.md 4.7).
+class o1bootsplash_device : public o1asset_device
+{
+public:
+	o1bootsplash_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock = 0);
+
+	static constexpr u32 BOOTSPLASH_SIZE = 0x1000;
+
+	virtual u32 asset_size() const noexcept override { return BOOTSPLASH_SIZE; }
+	virtual const char *asset_description() const noexcept override { return "the boot splash is one 4096-byte window page"; }
+	virtual const char *image_type_name() const noexcept override { return "bootsplash"; }
+	virtual const char *image_brief_type_name() const noexcept override { return "bootsplash"; }
+};
+
+
+class softrom_device : public device_t, public device_image_interface
+{
+public:
+	softrom_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock = 0);
+
+	// the ROM window, as the CPU sees it: 0000-1fff
+	u8 read(offs_t offset);
+
+	// The stock part, named by the machine that owns the region.  It is what
+	// the window serves with no image mounted, and what a 4 KB image mirrors.
+	void set_monitor_region(const char *tag) { m_monitor.set_tag(tag); }
+
+	// The ROM service's door.  `reg` is 0 = the request, 1 = the reply.  A read
+	// of the request register does not drive -- it answers 0xff -- so the
+	// machine can AND it with whatever else the bus has selected there.
+	u8 door_read(int reg);
+	void door_write(int reg, u8 data);
+
+	// what page 1 serves, for the harness and for the record
+	u8 page1() const { return m_page1; }
+
+protected:
+	// device_t
+	virtual void device_start() override ATTR_COLD;
+
+	// device_image_interface
+	virtual std::pair<std::error_condition, std::string> call_load() override;
+	virtual void call_unload() override;
+	virtual bool is_readable() const noexcept override { return true; }
+	virtual bool is_writeable() const noexcept override { return false; }
+	virtual bool is_creatable() const noexcept override { return false; }
+	virtual bool is_reset_on_load() const noexcept override { return true; }
+	virtual const char *file_extensions() const noexcept override { return "rom,bin"; }
+	virtual const char *image_type_name() const noexcept override { return "softrom"; }
+	virtual const char *image_brief_type_name() const noexcept override { return "softrom"; }
+
+private:
+	static constexpr u32 WINDOW_SIZE = 0x2000;  // 8 KB: 0000-1fff, A12 decoded
+	static constexpr u32 STOCK_SIZE  = 0x1000;  // the monitor: 4 KB at 0000-0fff
+
+	// what page 1 serves -- the content ids of PRESENT (docs/rom-pico-protocol.md
+	// section 4)
+	enum : u8
+	{
+		PAGE_PAYLOAD     = 0,   // CBIOS + MD-10 BIOS + the hand-over stub
+		PAGE_FRAME_CHARS = 1,   // the frame's character half
+		PAGE_FRAME_ATTRS = 2,   // the frame's attribute half, the 9th bit
+		PAGE_BOOTSPLASH  = 3    // the boot splash: the code the stub runs
+	};
+
+	// the ROM service's command set and result codes (docs/mailbox-protocol.md
+	// section 4, plus the one code the ROM's class adds)
+	static constexpr u8 OP_NOP     = 0x00;
+	static constexpr u8 OP_ECHO    = 0x01;
+	static constexpr u8 OP_PRESENT = 0x40;
+	static constexpr u8 OP_INFO    = 0x41;
+	static constexpr u8 RC_OK             = 0x00;
+	static constexpr u8 RC_UNKNOWN_OPCODE = 0x01;
+	static constexpr u8 RC_NO_CONTENT     = 0x09;
+	static constexpr u8 INFO_VERSION      = 0x01;
+	static constexpr u8 INFO_FLAG_FRAME      = 0x01;   // a frame is mounted
+	static constexpr u8 INFO_FLAG_BOOTSPLASH = 0x02;   // a boot splash is mounted
+
+	bool has_frame();
+	bool has_bootsplash();
+
+	void request(u8 data);
+	void execute();
+	void answer(u8 code, u8 const *payload, unsigned len);
+	void reset_transaction();
+
+	// The asset slots.  The tags are absolute because a finder resolves relative
+	// to the device that owns it, and the slots are the machine's, not this one's.
+	// The boot splash's tag and image *type* are both `bootsplash` -- not `screen`,
+	// which the machine's own video screen owns.  The image type is what names the
+	// command-line option, so that is `-bootsplash`.
+	required_region_ptr<u8>              m_monitor;     // the stock part, from the machine
+	optional_device<o1frame_device>      m_frame;       // the frame slot, ":frame"
+	optional_device<o1bootsplash_device> m_bootsplash;  // the boot splash, ":bootsplash"
+	offs_t                               m_mask;        // how the stock part mirrors: A12 ignored
+	std::vector<u8>                      m_image;       // the mounted image, empty if none
+	bool                                 m_mirror;      // the image is the stock part, so it mirrors
+
+	u8  m_page1;            // what page 1 serves
+	u8  m_request;          // the opcode being assembled, 0 if none
+	u8  m_operands[4];      // its operands, as they arrive
+	u8  m_operand_count;    // how many have arrived
+	u8  m_reply[8];         // the reply, m_reply[0] the result code
+	u8  m_reply_len;        // how long it is, 0 = nothing pending
+	u8  m_reply_at;         // how much of it has been read out
+};
+
+// device type definitions
+DECLARE_DEVICE_TYPE(SOFTROM, softrom_device)
+DECLARE_DEVICE_TYPE(O1FRAME, o1frame_device)
+DECLARE_DEVICE_TYPE(O1BOOTSPLASH, o1bootsplash_device)
+
+#endif // MAME_MACHINE_SOFTROM_H
