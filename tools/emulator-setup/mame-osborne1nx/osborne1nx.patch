@@ -0,0 +1,364 @@
+// license:BSD-3-Clause
+// copyright-holders:James Arlen
+/***************************************************************************
+
+    softROM -- the ROM window, the two flash assets, and the ROM service's door
+
+    See softrom.h for the window, the selector and the transaction, and
+    docs/rom-pico-protocol.md sections 2-5 for where all three come from.
+
+***************************************************************************/
+
+#include "emu.h"
+#include "softrom.h"
+
+// device type definitions
+DEFINE_DEVICE_TYPE(SOFTROM, softrom_device, "softrom", "SoftROM (the ROM window, from an image file)")
+DEFINE_DEVICE_TYPE(O1FRAME, o1frame_device, "o1frame", "O1 boot frame (two 4096-byte halves, from a file)")
+DEFINE_DEVICE_TYPE(O1BOOTSPLASH, o1bootsplash_device, "o1bootsplash", "O1 boot splash (the screen's code: one window page, from a file)")
+
+
+//-------------------------------------------------
+//  o1asset_device -- one of the interposer's flash assets
+//-------------------------------------------------
+
+o1asset_device::o1asset_device(const machine_config &mconfig, device_type type, const char *tag, device_t *owner, u32 clock)
+	: device_t(mconfig, type, tag, owner, clock)
+	, device_image_interface(mconfig, *this)
+{
+}
+
+void o1asset_device::device_start()
+{
+}
+
+std::pair<std::error_condition, std::string> o1asset_device::call_load()
+{
+	// An asset is exactly its own size and nothing else: the ROM serves a whole
+	// page -- or a whole half of one -- out of the window, so a short asset
+	// would leave the rest of that page reading 0xFF.
+	//
+	// The *trailer* is deliberately not checked here.  A frame is someone else's
+	// file, the check is the ROM's, and a missing frame, an erased frame and a
+	// corrupt one are one case (docs/rom-pico-protocol.md section 6).  The
+	// screen's code is not the ROM's file either: it is the interposer's, and
+	// tools/research/rom2blob.py --check is where its provenance is kept.
+	u32 const want = asset_size();
+	u32 const len = length();
+	if (len != want)
+		return std::make_pair(image_error::INVALIDLENGTH,
+				util::string_format("%s: %u bytes, not %u",
+					asset_description(), len, want));
+
+	m_data.resize(len);
+	if (fread(&m_data[0], len) != len)
+	{
+		m_data.clear();
+		return std::make_pair(std::errc::io_error, "could not read the asset");
+	}
+	return std::make_pair(std::error_condition(), std::string());
+}
+
+void o1asset_device::call_unload()
+{
+	m_data.clear();
+}
+
