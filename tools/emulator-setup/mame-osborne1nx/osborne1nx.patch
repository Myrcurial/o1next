+//-------------------------------------------------
+//  softrom_device -- the window, the selector and the door
+//-------------------------------------------------
+
+softrom_device::softrom_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock)
+	: device_t(mconfig, SOFTROM, tag, owner, clock)
+	, device_image_interface(mconfig, *this)
+	, m_monitor(*this, DEVICE_SELF)
+	, m_frame(*this, ":frame")
+	, m_bootsplash(*this, ":bootsplash")
+	, m_mask(0)
+	, m_mirror(false)
+	, m_page1(PAGE_PAYLOAD)
+	, m_request(0)
+	, m_operand_count(0)
+	, m_reply_len(0)
+	, m_reply_at(0)
+{
+}
+
+void softrom_device::device_start()
+{
+	// The stock part is what the window serves with no image mounted, and it is
+	// what the mainboard reads twice across the window because A12 was never
+	// decoded -- so the mirror is a mask over the region, not a second copy of
+	// it.  A region that is not a power of two cannot be mirrored this way.
+	assert(m_monitor.length() && !(m_monitor.length() & (m_monitor.length() - 1)));
+	m_mask = m_monitor.length() - 1;
+}
+
+std::pair<std::error_condition, std::string> softrom_device::call_load()
+{
+	u32 const len = length();
+	if (len > WINDOW_SIZE)
+		return std::make_pair(image_error::INVALIDLENGTH,
+				util::string_format("image is %u bytes; the ROM window is %u", len, WINDOW_SIZE));
+
+	m_image.resize(len);
+	if (len && (fread(&m_image[0], len) != len))
+	{
+		m_image.clear();
+		return std::make_pair(std::errc::io_error, "could not read the image");
+	}
+
+	// 4 KB or less is the stock part, and the stock part mirrors; anything
+	// larger is the two pages of the window
+	m_mirror = (len <= STOCK_SIZE);
+
+	// a new image is a new payload, so page 1 goes back to it: the frame is
+	// served by request, never by accident
+	m_page1 = PAGE_PAYLOAD;
+	return std::make_pair(std::error_condition(), std::string());
+}
+
+void softrom_device::call_unload()
+{
+	m_image.clear();
+	m_mirror = false;
+	m_page1 = PAGE_PAYLOAD;
+}
+
+u8 softrom_device::read(offs_t offset)
+{
+	// Page 1 is the selector's: the payload, or one of the interposer's own flash
+	// assets.  Those are flash rather than part of the window image, so they are
+	// served whatever that image is -- and past an asset's end the flash reads
+	// erased, exactly as it does past the end of a window image.  An asset that
+	// is asked for and not mounted is not a case *here*: the door refused the
+	// request, so page 1 never moved (execute()).
+	if (offset >= STOCK_SIZE)
+	{
+		std::vector<u8> const *asset = nullptr;
+		offs_t a = offset - STOCK_SIZE;
+
+		switch (m_page1)
+		{
+		case PAGE_FRAME_CHARS:
+		case PAGE_FRAME_ATTRS:
+			if (has_frame())
+			{
+				asset = &m_frame->data();
+				if (m_page1 == PAGE_FRAME_ATTRS)
+					a += o1frame_device::FRAME_SIZE / 2;
+			}
+			break;
+
+		case PAGE_BOOTSPLASH:
+			if (has_bootsplash())
+				asset = &m_bootsplash->data();
+			break;
+
+		default:
+			break;
+		}
+
+		if (asset)
+			return (a < asset->size()) ? (*asset)[a] : 0xff;
+	}
+
+	if (!m_image.empty())
+	{
+		offs_t const a = m_mirror ? (offset & m_mask) : offset;
+
+		// past the end of the image the flash is erased
+		return (a < m_image.size()) ? m_image[a] : 0xff;
+	}
+
+	// no image: the machine's own ROM, read across the window exactly as the
+	// stock machine reads it
+	return m_monitor[offset & m_mask];
+}
+
+
+//-------------------------------------------------
+//  the ROM service's door
+//-------------------------------------------------
+
+bool softrom_device::has_frame()
+{
+	return bool(m_frame) && m_frame->mounted();
+}
+
+bool softrom_device::has_bootsplash()
+{
+	return bool(m_bootsplash) && m_bootsplash->mounted();
+}
+
+void softrom_device::reset_transaction()
+{
+	m_request = 0;
+	m_operand_count = 0;
+}
+
+void softrom_device::answer(u8 code, u8 const *payload, unsigned len)
+{
+	m_reply[0] = code;
+	for (unsigned i = 0; i < len; i++)
+		m_reply[1 + i] = payload[i];
+	m_reply_len = 1 + len;
+	m_reply_at = 0;
+}
+
+void softrom_device::execute()
+{
+	u8 const op = m_request;
+	u8 const operand = m_operand_count ? m_operands[0] : 0;
+	reset_transaction();
+
+	switch (op)
+	{
+	case OP_ECHO:
+		// the presence probe: the byte comes back (mailbox-protocol.md 3)
+		answer(RC_OK, &operand, 1);
+		break;
+
+	case OP_INFO:
+		{
+			// for the web UI and for a human, not for the ROM: the ROM never
+			// asks whether a frame exists, because the trailer *is* the query
+			// (docs/rom-pico-protocol.md 4).  The flags are how something that
+			// is not the ROM tells a firmware with a frame -- or a boot splash
+			// -- from one without.
+			u8 const flags = (has_frame() ? INFO_FLAG_FRAME : 0)
+					| (has_bootsplash() ? INFO_FLAG_BOOTSPLASH : 0);
+			u8 const payload[2] = { INFO_VERSION, flags };
+			answer(RC_OK, payload, 2);
+		}
+		break;
+
+	case OP_PRESENT:
+		// Page 1 is the payload, one of the frame's halves, or the boot splash.
+		// An id the firmware does not serve -- or one whose asset is not
+		// mounted -- answers 09h and leaves page 1 alone, so the ROM keeps
+		// whatever it had (docs/rom-pico-protocol.md section 4.2).
+		if (operand == PAGE_PAYLOAD)
+		{
+			m_page1 = PAGE_PAYLOAD;
+			answer(RC_OK, nullptr, 0);
+		}
+		else if (((operand == PAGE_FRAME_CHARS) || (operand == PAGE_FRAME_ATTRS)) && has_frame())
+		{
+			m_page1 = operand;
+			answer(RC_OK, nullptr, 0);
+		}
+		else if ((operand == PAGE_BOOTSPLASH) && has_bootsplash())
+		{
+			m_page1 = operand;
+			answer(RC_OK, nullptr, 0);
+		}
+		else
+		{
+			answer(RC_NO_CONTENT, nullptr, 0);
+		}
+		break;
+
+	default:
+		answer(RC_UNKNOWN_OPCODE, nullptr, 0);
+		break;
+	}
+}
+
+void softrom_device::request(u8 data)
+{
+	// A write while a reply is pending abandons it and starts a new transaction,
+	// so a wedged client cannot wedge the firmware (mailbox-protocol.md 3).
+	m_reply_len = 0;
+	m_reply_at = 0;
+
+	if (!m_request)
+	{
+		// the first byte of a transaction is the opcode
+		switch (data)
+		{
+		case OP_ECHO:
+		case OP_PRESENT:
+			m_request = data;
+			m_operand_count = 0;
+			return;
+
+		case OP_INFO:
+			// no operands, so the reply is immediate
+			m_request = data;
+			m_operand_count = 0;
+			execute();
+			return;
+
+		case OP_NOP:
+			// "reset: abandon a partial request, answer OK" -- and the way back
+			// to a known state from anything (mailbox-protocol.md 3)
+			reset_transaction();
+			answer(RC_OK, nullptr, 0);
+			return;
+
+		default:
+			// an unknown opcode answers 01h and resets the operand count
+			reset_transaction();
+			answer(RC_UNKNOWN_OPCODE, nullptr, 0);
+			return;
+		}
+	}
+
+	if (m_operand_count < std::size(m_operands))
+		m_operands[m_operand_count++] = data;
+
+	unsigned const wanted =
+			(m_request == OP_ECHO) ? 1 :
+			(m_request == OP_PRESENT) ? 1 : 0;
+	if (m_operand_count >= wanted)
+		execute();
+}
+
+u8 softrom_device::door_read(int reg)
+{
+	// The request register is write-only, so it does not drive the bus.
+	if (reg != 1)
+		return 0xff;
+
+	// 0 = not ready, poll again.  N > 0 is the reply's length, and the next N
+	// reads are its bytes (mailbox-protocol.md 3).
+	if (!m_reply_len)
+		return 0;
+	if (!m_reply_at)
+	{
+		m_reply_at = 1;
+		return m_reply_len;
+	}
+
+	u8 const data = m_reply[m_reply_at - 1];
+	if (++m_reply_at > m_reply_len)
+	{
+		m_reply_len = 0;
+		m_reply_at = 0;
+	}
+	return data;
+}
+
+void softrom_device::door_write(int reg, u8 data)
+{
+	// only the request register takes writes; the reply register is read-only
+	if (reg == 0)
+		request(data);
+}
