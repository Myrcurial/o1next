+
+// The ROM service's door lives at DOOR_BASE, and *which* address that is is a
+// measurement rather than a preference.
+//
+// The protocol proposed 2300h/2301h (docs/rom-pico-protocol.md 2, 7 item 1), on
+// the grounds that o1-memory-io-map.md 7 calls 2300-23FF the largest clean
+// block.  It is not clean, and the reason is in this driver: the onboard selects
+// check only two address bits, so 2300h/2301h are also the floppy controller's
+// command/status and track registers and the keyboard's row 0 -- measured, and
+// recorded in docs/o1-mainboard-schematic.md 7a ("0x2301 is keyboard *and*
+// floppy", from tools/o1_mame_probe.lua's C9 report).  A reply register ANDed
+// with the FDC's track register -- 0x00 at the sign-on -- reads "not ready" for
+// ever, and a request written to 2300h is a floppy command.
+//
+// 2800h is inside the block o1-memory-io-map.md 7 recommends (2300-28FF) and is
+// the part of it nothing selects: no device mask matches A11 set with A8/A9/A10
+// clear, so the stock decode reads 0xFF there and the door answers alone.  The
+// rest of that region is not free either -- 2400h-27FF is the SCREEN-PAC's own
+// decode, presence bit included (2400h, bit 2 LOW = fitted), which the video
+// personality needs.
+//
+// The protocol is base-relative, so this is the whole of the correction: one
+// constant here, one in the ROM's client code, and the docs.
+static constexpr offs_t DOOR_BASE = 0x2800;   // bank 2: the request, then the reply
+
+u8 osborne1nx_state::bank2_peripherals_r(offs_t offset)
+{
+	// The bus fight is modelled rather than assumed away: the interposer's
+	// registers are ANDed with whatever else this address selects, exactly as
+	// the stock machine ANDs its own colliding devices.  At DOOR_BASE that is
+	// nothing, which is the point of choosing it -- and the same code is what
+	// would show the corruption if the door were moved back onto a device.
+	u8 data = osborne1_state::bank2_peripherals_r(offset);
+
+	offs_t const a = offset + 0x2000;
+	if ((a == DOOR_BASE) || (a == DOOR_BASE + 1))
+		data &= m_softrom->door_read(int(a - DOOR_BASE));
+
+	return data;
+}
+
+void osborne1nx_state::bank2_peripherals_w(offs_t offset, u8 data)
+{
+	// only the request register takes writes; the reply register is read-only
+	if ((offset + 0x2000) == DOOR_BASE)
+	{
+		m_softrom->door_write(0, data);
+		return;
+	}
+
+	osborne1_state::bank2_peripherals_w(offset, data);
 }
 
 
