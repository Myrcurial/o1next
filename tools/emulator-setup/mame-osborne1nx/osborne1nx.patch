+// license:BSD-3-Clause
+// copyright-holders:James Arlen
+/***************************************************************************
+
+    Adaptec ACB-4000 host adapter -- the Z80-side card
+
+    The ACB-4000 itself is a SCSI target with its own 8080 firmware (the
+    archive holds six 8 KiB ROM images for it).  What a Z80 machine has is a
+    *host adapter* -- a SCSI initiator -- and that is the machine-specific
+    half.  docs/harddisk-decision.md section 5 splits the personality into
+    three layers: the SCSI target (machine independent), this host-adapter
+    shim (a port block, i.e. a profile) and the backing store.  This device is
+    the middle layer, and it is what the emulated interposer answers with.
+
+    The Osborne 1 / MD-10 profile presents four registers on four consecutive
+    I/O ports, decoded from the full 8-bit address:
+
+        base+0  data      -- also the block port (OUTI/INI/OTIR/INIR, C=base)
+        base+1  control   (write only)
+        base+2  status (read) / control (write)
+        base+3  control   (write only)
+
+    The status byte's bit map and the whole handshake are *read*, not guessed:
+    the transaction routine is the MD-10 BIOS overlay's own code, at
+    HARDBIOS.SPR file offset 0x285 (address 0xE285, "HARDBIOS.SPR maps to
+    0xE000 + offset").  See docs/osborne1nx-machine.md for the listing and
+    docs/acb4000-host-adapter.md section 1 for the register roles.
+
+    Status (base+2, read), md10 profile:
+
+        bit 0  01h  selection handshake -- clear at rest, set while the host
+                    has selected the card and the card has acknowledged
+        bit 1  02h  REQ -- move a byte (or a 512-byte block) now
+        bit 2  04h  one controller on-line -- the presence probe reads this
+        bit 5  20h  phase -- 1 = command/status/message, 0 = data
+        bit 6  40h  the current phase is complete, act on it
+
+    Two details of that map are load-bearing, and both were read out of the
+    driver rather than assumed (docs/osborne1nx-machine.md section 4):
+
+      * The status phase asserts PHASE and END but **not** REQ.  The driver's
+        data-out loop writes a byte for every REQ it sees (overlay 0x808d), so
+        a REQ left up while the status byte waits would have it write for ever.
+      * The status byte stays on the data register for two reads.  The routine
+        reads it into B (`in b,(c)`) and then reads the register again to
+        acknowledge; a byte-at-a-time data-in transfer reads it once more,
+        because its loop takes a byte before it notices the phase has changed.
+
+    The controller is at SCSI ID 01 (ACB-4000 OEM manual, Appendix A).
+
+***************************************************************************/
+
+#ifndef MAME_MACHINE_ACB4000_HOST_ADAPTER_H
+#define MAME_MACHINE_ACB4000_HOST_ADAPTER_H
+
+#pragma once
+
+#include "machine/legscsi.h"
+
+
+class acb4000_host_adapter_device : public legacy_scsi_host_adapter
+{
+public:
+	acb4000_host_adapter_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock = 0);
+
+	// configuration helpers
+	void set_target_id(u8 id) { m_target_id = id; }
+
+	// the four registers, relative to the base port
+	u8 read(offs_t offset);
+	void write(offs_t offset, u8 data);
+
+protected:
+	virtual void device_start() override ATTR_COLD;
+	virtual void device_reset() override ATTR_COLD;
+
+private:
+	enum : u8
+	{
+		STATUS_SELECT = 0x01,   // bit 0 -- selection handshake
+		STATUS_REQ    = 0x02,   // bit 1 -- request: move a byte
+		STATUS_ONLINE = 0x04,   // bit 2 -- one controller on-line
+		STATUS_PHASE  = 0x20,   // bit 5 -- 1 = command/status/message
+		STATUS_END    = 0x40    // bit 6 -- phase complete
+	};
+	enum : u8 { CTRL_SELECT = 0x10 };   // written to base+2 to start a transfer
+
+	enum class xfer : u8 { idle, selected, command, data_in, data_out, status };
+
+	static int cdb_length(u8 opcode);
+	bool select_target();
+	void start_command();
+	void begin_data(bool data_in);
+	void begin_status();
+	u8 read_data_byte();
+	void write_data_byte(u8 data);
+	u8 status_bits() const;
+
+	u8      m_target_id;
+
+	u8      m_reg1;         // base+1 latch (write only)
+	u8      m_reg2;         // base+2 -- read/write controller-select register
+	u8      m_reg3;         // base+3 latch (write only)
+	u8      m_select;       // the byte the host wrote to base+0 to select
+	u8      m_last_read;    // the last byte handed to the host on base+0
+
+	xfer    m_xfer;
+	u8      m_cdb[16];
+	int     m_cdb_index;
+	int     m_cdb_length;
+
+	u8      m_buffer[512];  // the adapter's block buffer
+	int     m_buffer_count; // bytes valid in m_buffer
+	int     m_buffer_index; // bytes already moved
+	u32     m_transferred;  // bytes moved across the whole data phase
+	u32     m_total;        // bytes the target reported
+
+	bool    m_online;
+};
+
+// device type definition
+DECLARE_DEVICE_TYPE(ACB4000_HOST_ADAPTER, acb4000_host_adapter_device)
+
+#endif // MAME_MACHINE_ACB4000_HOST_ADAPTER_H
