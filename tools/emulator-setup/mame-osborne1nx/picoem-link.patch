+u8 osborne1nx_state::bank2_peripherals_r(offs_t offset)
+{
+	// The bus fight is modelled rather than assumed away: the interposer's
+	// registers are ANDed with whatever else this address selects, exactly as
+	// the stock machine ANDs its own colliding devices.  At DOOR_BASE that is
+	// nothing, which is the point of choosing it -- and the same code is what
+	// would show the corruption if the door were moved back onto a device.
+	u8 data = osborne1_state::bank2_peripherals_r(offset);
+
+	offs_t const a = offset + 0x2000;
+	if ((a == DOOR_BASE) || (a == DOOR_BASE + 1))
+		data &= m_softrom->door_read(int(a - DOOR_BASE));
+
+	return data;
+}
+
+void osborne1nx_state::bank2_peripherals_w(offs_t offset, u8 data)
+{
+	// only the request register takes writes; the reply register is read-only
+	if ((offset + 0x2000) == DOOR_BASE)
+	{
+		m_softrom->door_write(0, data);
+		return;
+	}
+
+	osborne1_state::bank2_peripherals_w(offset, data);
+}
