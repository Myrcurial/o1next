+// license:BSD-3-Clause
+// copyright-holders:James Arlen
+/***************************************************************************
+
+    picoem_link -- the card's window, answered by a real RP2354B firmware
+
+    See docs/emulation-testbed.md section 5 (Gate A) and docs/picoem-bridge.md
+    for the wire.  This device is the MAME half of it: it owns the FIFO pair,
+    sends a 24-byte frame for each I/O access in the window, blocks for the
+    reply, and returns the byte the firmware drove.
+
+    WHY A DEVICE AND NOT A LUA TAP
+        A Lua read tap cannot return data to the guest: it segfaults once the
+        guest polls in a tight loop (measured on MAME 0.289,
+        tools/research/acb4000.lua GOTCHAS).  A device can, and *blocking* is
+        what the card needs -- the Z80's cycle has to be answered before it
+        continues, which a frame-quantised socket would not give.
+
+    WHY THE CHIP IS NOT IN THIS PROCESS
+        The bridge owns the emulated RP2354B, because `Bus::gpio_external_mask`
+        is a plain u32 rather than an atomic, so stepping the chip and driving
+        its pins have to be the same thread.  This device is the other end of a
+        pipe, and the pipe is a pair of FIFOs because MAME's Lua has no socket
+        library and a C++ socket would be a second patch to the same tree.
+
+    THE HAZARD, STATED
+        A blocking read on a FIFO never returns if the peer dies.  The bridge
+        holds both ends open for the life of the run, so a MAME that exits frees
+        the bridge, but a bridge that exits leaves MAME blocked until it is
+        killed.  `tools/emulator-setup/mame-osborne1nx/picoem-check.sh` kills
+        both ends on every exit path.
+
+***************************************************************************/
+#ifndef MAME_MACHINE_PICOEM_LINK_H
+#define MAME_MACHINE_PICOEM_LINK_H
+
+#pragma once
+
+class picoem_link_device : public device_t
+{
+public:
+	picoem_link_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock = 0);
+
+	u8 read(offs_t offset);
+	void write(offs_t offset, u8 data);
+
+protected:
+	virtual void device_start() override ATTR_COLD;
+	virtual void device_stop() override ATTR_COLD;
+
+private:
+	static constexpr unsigned FRAME_LEN = 24;
+	static constexpr u8 OP_HELLO     = 0;
+	static constexpr u8 OP_BUS_WRITE = 1;
+	static constexpr u8 OP_BUS_READ  = 2;
+	static constexpr u8 STATUS_OK    = 0;
+
+	// MAME hands an address-map handler the offset *relative to the entry's
+	// start*, measured: a guest `OUT (31h),A` in a `map(30h,33h)` window arrives
+	// as offset 1.  The firmware decodes the full 8-bit port -- that is the whole
+	// point of the machine -- so the base has to be put back.  The card device in
+	// `osborne1nx` hides this with `offset & 0x03`, which is a no-op either way.
+	static constexpr u8 WINDOW_BASE = 0x30;
+
+	bool open_channel();
+	bool transact(u8 op, u8 port, u8 data, u8 &reply_data, u8 &hb, u8 &flags);
+	void report(char const *what, u8 port, u8 data, u8 reply_data, u8 hb, u8 flags);
+	void warn_dead();
+
+	int  m_fd_out = -1;         // requests: MAME -> bridge
+	int  m_fd_in = -1;          // replies:  bridge -> MAME
+	bool m_dead = false;
+	bool m_warned = false;
+	u16  m_seq = 0;
+	u32  m_last_pc = 0;
+	u32  m_last_cycles = 0;
+};
+
+DECLARE_DEVICE_TYPE(PICOEM_LINK, picoem_link_device)
+
+#endif // MAME_MACHINE_PICOEM_LINK_H
