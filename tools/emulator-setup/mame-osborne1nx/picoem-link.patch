+// license:BSD-3-Clause
+// copyright-holders:James Arlen
+/***************************************************************************
+
+    picoem_link -- the card's window, answered by a real RP2354B firmware
+
+    The frame format is the contract in docs/picoem-bridge.md section 3.
+    `tools/picoem-bridge/src/frame.rs` is the reference copy and the Lua copy is
+    `tools/emulator-setup/mame-osborne1nx/o1next-picoem.lua`; the Rust tests pin
+    the layout, so if this file disagrees with them, this file is wrong.
+
+    Request (MAME -> bridge), 24 bytes, little-endian:
+        0  4  magic "O1B1"
+        4  1  op: 0 HELLO, 1 BUS_WRITE, 2 BUS_READ
+        5  1  flags: bit0 0 = I/O cycle, 1 = memory cycle
+        6  1  port
+        7  1  data -- the byte the Z80 drove
+        8  2  addr (memory cycles; 0 here)
+       10  2  seq, echoed back
+       12  4  cycles for this transaction; 0 = the bridge's default
+       16  4  reserved
+       20  2  checksum = sum of bytes 0..19
+       22  2  reserved
+
+    Reply (bridge -> MAME):
+        0  4  magic
+        4  1  status: 0 OK, 1 no firmware running, 2 bad request
+        5  1  data -- the byte the chip drove on GP0-GP7
+        6  1  hb   -- GP26 edges; 1 = the firmware handled the transaction
+        7  1  flags
+        8  2  addr echo
+       10  2  seq echo
+       12  4  pc -- the firmware's PC after the transaction
+       16  4  cycles -- the emulated chip's total cycle count
+       20  2  checksum
+       22  2  reserved
+
+    `pc` and `cycles` are in *every* reply rather than in a HELLO exchange only,
+    because "the firmware is running" is the first thing to go wrong and the
+    hardest thing to see from this side -- and because the cycle count is what a
+    personality's cycle budget is asserted against
+    (docs/emulation-testbed.md section 7).
+
+***************************************************************************/
+
+#include "emu.h"
+#include "picoem_link.h"
+
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+DEFINE_DEVICE_TYPE(PICOEM_LINK, picoem_link_device, "picoem_link", "picoem link (the card's window, from a real RP2354B firmware)")
+
+
+namespace {
+
+char const MAGIC[4] = { 'O', '1', 'B', '1' };
+
+void put_u16(u8 *p, u16 v) { p[0] = u8(v); p[1] = u8(v >> 8); }
+void put_u32(u8 *p, u32 v) { p[0] = u8(v); p[1] = u8(v >> 8); p[2] = u8(v >> 16); p[3] = u8(v >> 24); }
+
+u16 get_u16(u8 const *p) { return u16(p[0]) | (u16(p[1]) << 8); }
+u32 get_u32(u8 const *p) { return u32(p[0]) | (u32(p[1]) << 8) | (u32(p[2]) << 16) | (u32(p[3]) << 24); }
+
+u16 frame_checksum(u8 const *p, unsigned len)
+{
+	u16 t = 0;
+	for (unsigned i = 0; i < len; i++)
+		t = u16(t + p[i]);
+	return t;
+}
+
+// A FIFO read or write can return short, and a signal can interrupt it.  Loop
+// until the whole frame has moved or the channel is genuinely gone.
+bool write_all(int fd, u8 const *p, unsigned len)
+{
+	unsigned done = 0;
+	while (done < len)
+	{
+		ssize_t n = ::write(fd, p + done, len - done);
+		if (0 > n)
+		{
+			if (EINTR == errno)
+				continue;
+			return false;
+		}
+		done += unsigned(n);
+	}
+	return true;
+}
+
+bool read_all(int fd, u8 *p, unsigned len)
+{
+	unsigned done = 0;
+	while (done < len)
+	{
+		ssize_t n = ::read(fd, p + done, len - done);
+		if (0 > n)
+		{
+			if (EINTR == errno)
+				continue;
+			return false;
+		}
+		if (0 == n)
+			return false; // the peer closed
+		done += unsigned(n);
+	}
+	return true;
+}
+
+} // anonymous namespace
+
+
+picoem_link_device::picoem_link_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock) :
+	device_t(mconfig, PICOEM_LINK, tag, owner, clock)
+{
+}
+
+
+void picoem_link_device::device_start()
+{
+	if (!open_channel())
+	{
+		m_dead = true;
+		return;
+	}
+
+	// HELLO is not decoration: "the firmware is running" is the first thing that
+	// goes wrong, and from this side it looks identical to a firmware that is
+	// running and answering nothing.
+	u8 data = 0, hb = 0, flags = 0;
+	if (!transact(OP_HELLO, 0, 0, data, hb, flags))
+	{
+		osd_printf_error("picoem: HELLO failed -- the bridge is there and the firmware is not answering\n");
+		m_dead = true;
+		return;
+	}
+
+	osd_printf_info("picoem: HELLO  status 00  firmware pc=%08X cycles=%d\n",
+			m_last_pc, m_last_cycles);
+}
+
+
+void picoem_link_device::device_stop()
+{
+	if (0 <= m_fd_out)
+	{
+		::close(m_fd_out);
+		m_fd_out = -1;
+	}
+	if (0 <= m_fd_in)
+	{
+		::close(m_fd_in);
+		m_fd_in = -1;
+	}
+}
+
+
+bool picoem_link_device::open_channel()
+{
+	char const *in_path  = std::getenv("O1_PICOEM_IN");
+	char const *out_path = std::getenv("O1_PICOEM_OUT");
+	if (!in_path)
+		in_path = "/tmp/o1next-picoem/in";
+	if (!out_path)
+		out_path = "/tmp/o1next-picoem/out";
+
+	// O_RDWR on a FIFO does not block on open, which is what makes a FIFO a
+	// usable byte stream here with no open-order deadlock.  The Lua end opens
+	// the same two paths with "r+b" for the same reason.
+	m_fd_out = ::open(in_path, O_RDWR);
+	if (0 > m_fd_out)
+	{
+		osd_printf_error("picoem: NO BRIDGE -- %s could not be opened (%s)\n",
+				in_path, std::strerror(errno));
+		osd_printf_error("picoem: start tools/picoem-bridge first (see docs/emulation-testbed.md)\n");
+		return false;
+	}
+
+	m_fd_in = ::open(out_path, O_RDWR);
+	if (0 > m_fd_in)
+	{
+		osd_printf_error("picoem: NO BRIDGE -- %s could not be opened (%s)\n",
+				out_path, std::strerror(errno));
+		::close(m_fd_out);
+		m_fd_out = -1;
+		return false;
+	}
+
+	osd_printf_info("picoem: channel %s -> %s\n", in_path, out_path);
+	return true;
+}
+
+
+bool picoem_link_device::transact(u8 op, u8 port, u8 data, u8 &reply_data, u8 &hb, u8 &flags)
+{
+	if (m_dead)
+		return false;
+
+	m_seq++;
+
+	u8 req[FRAME_LEN];
+	std::memcpy(req, MAGIC, 4);
+	req[4] = op;
+	req[5] = 0;                 // flags: 0 = an I/O cycle
+	req[6] = port;
+	req[7] = data;
+	put_u16(&req[8], 0);        // addr: memory cycles only
+	put_u16(&req[10], m_seq);
+	put_u32(&req[12], 0);       // cycles: the bridge's default
+	put_u32(&req[16], 0);       // reserved
+	put_u16(&req[20], frame_checksum(req, 20));
+	put_u16(&req[22], 0);
+
+	if (!write_all(m_fd_out, req, FRAME_LEN))
+	{
+		osd_printf_error("picoem: the channel died writing a request\n");
+		m_dead = true;
+		return false;
+	}
+
+	u8 rep[FRAME_LEN];
+	if (!read_all(m_fd_in, rep, FRAME_LEN))
+	{
+		osd_printf_error("picoem: the channel died waiting for a reply\n");
+		m_dead = true;
+		return false;
+	}
+
+	// The transport is a byte stream with no message boundaries, so a reader
+	// that has drifted has to be able to *see* that it has.
+	if (std::memcmp(rep, MAGIC, 4) != 0)
+	{
+		osd_printf_error("picoem: bad magic in the reply -- the stream has drifted\n");
+		m_dead = true;
+		return false;
+	}
+	if (get_u16(&rep[20]) != frame_checksum(rep, 20))
+	{
+		osd_printf_error("picoem: bad checksum in the reply -- the stream has drifted\n");
+		m_dead = true;
+		return false;
+	}
+	if (get_u16(&rep[10]) != m_seq)
+	{
+		osd_printf_error("picoem: reply seq %u, expected %u\n", get_u16(&rep[10]), m_seq);
+		m_dead = true;
+		return false;
+	}
+	if (rep[4] != STATUS_OK)
+	{
+		osd_printf_error("picoem: status %02X -- the bridge refused the transaction\n", rep[4]);
+		return false;
+	}
+
+	reply_data = rep[5];
+	hb = rep[6];
+	flags = rep[7];
+	m_last_pc = get_u32(&rep[12]);
+	m_last_cycles = get_u32(&rep[16]);
+	return true;
+}
+
+
+void picoem_link_device::report(char const *what, u8 port, u8 data, u8 reply_data, u8 hb, u8 flags)
+{
+	if ('W' == what[0])
+		osd_printf_info("picoem: W %02X <- %02X  firmware drove %02X  hb=%u %s%s%s  pc=%08X cycles=%d\n",
+				port, data, reply_data,
+				hb,
+				(flags & 0x01) ? "HB " : "-- ",
+				(flags & 0x02) ? "OE " : "-- ",
+				(flags & 0x04) ? "DRV" : "---",
+				m_last_pc, m_last_cycles);
+	else
+		osd_printf_info("picoem: R %02X      firmware drove %02X  hb=%u %s%s%s  (guest read %02X)  pc=%08X cycles=%d\n",
+				port, reply_data,
+				hb,
+				(flags & 0x01) ? "HB " : "-- ",
+				(flags & 0x02) ? "OE " : "-- ",
+				(flags & 0x04) ? "DRV" : "---",
+				reply_data,
+				m_last_pc, m_last_cycles);
+}
+
+
+void picoem_link_device::warn_dead()
+{
+	if (!m_warned)
+	{
+		osd_printf_error("picoem: the link is down -- accesses in the window answer 0xFF\n");
+		m_warned = true;
+	}
+}
+
+
+u8 picoem_link_device::read(offs_t offset)
+{
+	u8 const port = u8(WINDOW_BASE + (offset & 0x03));
+	u8 data = 0, hb = 0, flags = 0;
+	if (!transact(OP_BUS_READ, port, 0, data, hb, flags))
+	{
+		warn_dead();
+		return 0xff;
+	}
+	report("R", port, 0, data, hb, flags);
+	return data;
+}
+
+
+void picoem_link_device::write(offs_t offset, u8 data)
+{
+	u8 const port = u8(WINDOW_BASE + (offset & 0x03));
+	u8 reply_data = 0, hb = 0, flags = 0;
+	if (!transact(OP_BUS_WRITE, port, data, reply_data, hb, flags))
+	{
+		warn_dead();
+		return;
+	}
+	report("W", port, data, reply_data, hb, flags);
+}
