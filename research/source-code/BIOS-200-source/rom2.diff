+	LK	DE,0D806H
+	LK	C,12H
+	LDIR
+	LK	DE,0D86AH
+	LK	C,15H
+	LDIR
+	LK	DE,0D82DH
+	LK	C,03H
+	LDIR
+	LK	DE,0D87FH
+	LK	C,03H
+	LDIR
+	LK	DE,0D833H
+	LK	C,2DH
+	LDIR
 
+;THE HAND-OVER'S ONE STORE, AND ONLY RAM CAN MAKE IT (#247).  THE ROM'S 60 HZ
+;HANDLER RETURNS THROUGH THE CBIOS AT CCPADR+1633H, AND CCPADR IS THIS ROM'S
+;OWN CBOOT'S TO WRITE -- HARD.COM'S LOADER NEVER DID, SO THE EXIT LANDS ON
+;1633H AND THE MACHINE NEVER COMES BACK.  IT CANNOT BE WRITTEN FROM BANK 2:
+;PAGE ZERO IS THIS ROM AND 0EFD2H IS ONLY REACHED IN RAM MODE.  SO A STUB
+;COMES OUT OF THE PAYLOAD'S SPARE INTO RAM, AND THE SWITCH ENTERS *IT*.
 
+;THE STUB'S BYTES ARE THE PAYLOAD'S (tools/research/rom2image.py, 1E01H) --
+;THE ROM CANNOT HOLD IT AND RUN IT, BECAUSE IT HAS TO RUN IN RAM:
+;	LD	HL,0CB00H	;CCPADR: the exit's base, not this boot's CCP
+;	LD	(0EFD2H),HL	;0CB00H+1633H = 0E133H, the CBIOS'S RRI
+;	LD	A,80H		;the CBIOS'S own IOBYTE default
+;	LD	(0003H),A	;... for the console dispatch
+;	JP	0D800H		;the MD-10 BIOS'S jump table
+;CCPADR IS THE ROM'S WAY OF SAYING WHERE THE CBIOS IS, NOT WHERE THE CCP IS:
+;ITS CBOOT WRITES ITS CCP'S ADDRESS THERE (0CB00H, A FLOPPY BOOT) AND THE
+;EXIT ADDS 1633H -- THE STOCK CCP-TO-CBIOS OFFSET -- TO FIND THE CBIOS'S
+;RRI.  THIS BOOT PUTS THE SYSTEM AT 0C200H AND STILL PUTS THE CBIOS AT
+;0E100H, SO 0CB00H IS THE RIGHT VALUE AND THE STOCK ONE.
+
+	LK	HL,1E01H		;the stub, out of the payload's spare
+	LK	DE,0E0F0H		;... to RAM: the 104 bytes below the CBIOS
+	LK	C,0EH			;14 bytes -- the stub's length
+	LDIR
+
+;INTO THE MD-10 BIOS, BUT THE BANK FIRST: ITS BOOT PATCHES PAGE ZERO, AND THAT
+;WRITE IS DROPPED WHILE THIS ROM IS MAPPED.  SW2RAM IS THE CBIOS'S OWN SWITCH,
+;IN THE RAM JUST FILLED, AND ITS RET TAKES THE ADDRESS PUSHED HERE -- THE STUB,
