+	PROC
+	DISDIM
+	ENADIM
+	LK	HL,0F000H
+	STO	0FFH,[HL]
+	LK	DE,0F001H
+	LK	BC,0FFFH
+	LDIR
+	DISDIM
+	LDK	DE,IMSG
+	CALL	OSTR
+	RET
