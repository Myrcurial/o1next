# Large binaries are tracked in-repo intentionally (research archive),
# but ignore OS cruft and working outputs.
.DS_Store
*.o
*.elf
*.uf2
__pycache__/
build/
*.kicad_prl
# KiCad's own backup and history directories appear beside a schematic the first
# time it is opened or exported, and a .kicad_sch inside either of them makes
# tools/check_boards.py fail ("belongs to no board").
.history/
*-backups/

# Local Jekyll build output.  site/ is published by
# .github/workflows/jekyll-gh-pages.yml, which builds into _site/ and installs
# its own dependencies, so none of this belongs in the repo.
_site/
.jekyll-cache/
Gemfile.lock

# The build-time Python for tools/romfont.py.  Homebrew's Python is PEP 668
# externally-managed and refuses `pip3 install fonttools brotli` outright, and
# which interpreter `python3` is differs by machine, so the venv that
# tools/bootstrap.sh creates is the portable answer.  Never committed.
.venv/

# The picoem bridge's Rust build output.  tools/ is otherwise Python stdlib
# only; tools/picoem-bridge/ is the documented exception (tools/README.md).
tools/picoem-bridge/target/
