  (text "floppy-adapter: switchable Gotek / physical-drive daughter card (issue #62)" (at 320 160 0) (effects (font (size 1.6 1.6))) (uuid "1ab63a7b-717b-4606-ae7f-3e8e594bb646"))
  (text "J1 (female 2x17 socket) mates the O1 logic-board 34-pin MALE header (P8)." (at 320 166 0) (effects (font (size 1.6 1.6))) (uuid "083d67f9-3aee-4b1d-9a83-d14fcd24c241"))
  (text "J2 passes every pin but DS-A straight through to the OEM cable." (at 320 172 0) (effects (font (size 1.6 1.6))) (uuid "cac26596-b676-4ff4-b377-0456936f462c"))
  (text "K1 4PDT: pole1 = +5V, pole2 = GND, pole3 = DS-A (NC=physical, NO=Gotek)." (at 320 178 0) (effects (font (size 1.6 1.6))) (uuid "f5afcb3d-71fa-4601-b0d6-cc8fb69a0538"))
  (text "De-energised = physical drives (fail-safe).  J5 carries coil current only." (at 320 184 0) (effects (font (size 1.6 1.6))) (uuid "6ef704d3-c37c-4cf8-97dd-026319c56e96"))
  (text "Gotek +5V and GND reach it ONLY via J4, never through the J3 signal header." (at 320 190 0) (effects (font (size 1.6 1.6))) (uuid "aebc18fa-a217-4057-9f76-7b77c8c63cce"))
  (text "R3 = 1k DS-A pull-up on the Gotek side; R4 = 150R alternative (fit one)." (at 320 196 0) (effects (font (size 1.6 1.6))) (uuid "42df51a8-14b4-478c-8511-7eff4a4883bc"))
  (text "O1 150R terminator, and the Gotek has no pull-up on its select lines." (at 320 202 0) (effects (font (size 1.6 1.6))) (uuid "91ea3fbd-d027-4778-9925-c787400a2871"))
  (text "Set the Gotek select jumper to the position that answers the O1 drive-A" (at 320 208 0) (effects (font (size 1.6 1.6))) (uuid "f340d1d5-197b-402a-bf77-fbba2f76ca31"))
  (text "select (pin 10) - see docs/floppy-adapter-design.md sec. 8." (at 320 214 0) (effects (font (size 1.6 1.6))) (uuid "30fc43e3-9116-4f0d-b9b1-050b9d52b1ee"))
