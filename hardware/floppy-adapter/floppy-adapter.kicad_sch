  (text "GOTEK POWER" (at 117.5 146.0 0) (effects (font (size 2.5 2.5) (thickness 0.4) bold) (justify left)) (uuid "ca530ef2-f16f-4b37-ad6d-5bfc7d5b7231"))
  (text "floppy-adapter: switchable Gotek / physical-drive daughter card (issue #62)" (at 232 30 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "1a78448c-f921-4308-a19c-ae5ed5a675e3"))
  (text "J1 (female 2x17 socket) mates the O1 logic-board 34-pin MALE header (P8)." (at 232 36 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "05c3e50e-32dd-4599-bb81-e5a2b1fad64e"))
  (text "J2 passes every pin but DS-A straight through to the OEM cable." (at 232 42 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "1f1198ab-75d3-4fdf-8996-08a01ae25850"))
  (text "K1 4PDT: pole1 = +5V, pole2 = GND, pole3 = DS-A (NC=physical, NO=Gotek)." (at 232 48 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "d0ca8282-a91c-4891-8d89-79bf7ed1a4b0"))
  (text "De-energised = physical drives (fail-safe).  J5 carries coil current only." (at 232 54 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "1ed18694-136e-41fc-9a0c-d0e5fd7df78d"))
  (text "Gotek +5V and GND reach it ONLY via J4, never through the J3 signal header." (at 232 60 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "0117437b-b4d5-4432-a8be-21591d140ad8"))
  (text "R3 = 1k DS-A pull-up on the Gotek side; R4 = 150R alternative (fit one)." (at 232 66 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "f0191e9e-faf0-43dc-baf8-4b8f6980c0b5"))
  (text "O1 150R terminator, and the Gotek has no pull-up on its select lines." (at 232 72 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "4ee74164-f288-4daf-93a2-a520633afa0c"))
  (text "Set the Gotek select jumper to the position that answers the O1 drive-A" (at 232 78 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "29bd3efd-901a-4570-bcef-4f178237f4ca"))
  (text "select (pin 10) - see docs/floppy-adapter-design.md sec. 8." (at 232 84 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "a02ba077-7643-45c5-bee2-41ead0882c41"))
  (text "Pins 4 (TG43) and 6 (EARLY) carry live FDC outputs: pass through, never GND." (at 232 90 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "0f0804b3-5d76-4b27-857c-6fb928bb4751"))
  (text "K1 has NO footprint yet: no 4-pole DIP signal relay is in production." (at 232 96 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "de4f8c2f-a967-4d2c-b447-af09e2db1734"))
  (text "GND/+5V/+12V are wired like any other net, with one power symbol per rail." (at 232 102 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "5dd7ed53-7599-41b8-b0c7-4c62efb62f26"))
