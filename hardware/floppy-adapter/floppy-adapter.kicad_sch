  (text "PASS-THROUGH" (at 40.0 20.0 0) (effects (font (size 2.5 2.5) (thickness 0.4) bold) (justify left)) (uuid "c3bdc065-f524-4fab-9684-f93a805c81d6"))
  (text "GOTEK SIGNALS" (at 40.0 130.0 0) (effects (font (size 2.5 2.5) (thickness 0.4) bold) (justify left)) (uuid "a06c3adb-ea53-4ead-adfd-d2340d08db4a"))
  (text "SWITCHING" (at 40.0 146.0 0) (effects (font (size 2.5 2.5) (thickness 0.4) bold) (justify left)) (uuid "788abec6-31b9-459c-a94b-f2c0c76ef541"))
  (text "GOTEK POWER" (at 117.5 146.0 0) (effects (font (size 2.5 2.5) (thickness 0.4) bold) (justify left)) (uuid "e8464fbb-4d3c-454e-a54f-dc34e97257c5"))
  (text "floppy-adapter: switchable Gotek / physical-drive daughter card (issue #62)" (at 232 30 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "5ad5a62e-b2ef-48f1-984c-ac36d17f99f5"))
  (text "J1 (female 2x17 socket) mates the O1 logic-board 34-pin MALE header (P8)." (at 232 36 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "a1aaf869-dd73-48aa-b40b-8fdb69a76645"))
  (text "J2 passes every pin but DS-A straight through to the OEM cable." (at 232 42 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "42a9c74a-4a2b-4b98-9481-9c2eb449472e"))
  (text "PANEL SWITCH: UP = physical drives, DOWN = Gotek.  It ties the lead to" (at 232 48 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "9e17c9b7-81d4-4671-957f-cfca8c9c2d36"))
  (text "+5V (down) or leaves it to R1 (up), so up is the fail-safe position." (at 232 54 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "56874229-2946-4d6e-a984-b294854dd179"))
  (text "U1 = NC7SB3157P6X 2:1 switch: DS-A goes to B0 (physical) when S is LOW," (at 232 60 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "6b0c1777-ffdb-4b03-a5b4-adef0d59ee5e"))
  (text "and to B1 (Gotek) when S is HIGH.  Low/float/unplugged = physical drives." (at 232 66 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "94824d9c-ce5f-4f28-aaf8-6eb12621c654"))
  (text "R5 = 1k in series with the switch lead: it leaves the board, so it gets one." (at 232 72 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "fe159961-f85f-4928-9d62-2e6330307660"))
  (text "R1 = 10k control pull-down, so a broken or unplugged switch lead is safe." (at 232 78 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "82097515-c6bb-4b63-86df-303e0d54f11f"))
  (text "U2 = TPS22918 switches the Gotek +5V; Q1 = AO3400A switches its GND." (at 232 84 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "ac3eaeb8-2df2-469a-bf0a-104a570e61ce"))
  (text "Both rails, always: +5V alone leaves the Gotek parasitically powered," (at 232 90 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "f661b8dc-4ea8-440b-94cd-d5a63529b2b6"))
  (text "GND alone upsets the other drive (design doc sec.4.2).  CT and QOD are open." (at 232 96 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "63e8ec13-334c-43d1-a25f-7d8063071ab0"))
  (text "Gotek +5V and GND reach it ONLY via J4, never through the J3 signal header." (at 232 102 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "b3787097-681a-4bb7-a51f-0780a94d7206"))
  (text "R3 = 1k DS-A pull-up on the Gotek side; R4 = 150R alternative (fit one)." (at 232 108 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "85d627c5-1d0d-4e48-9117-f4b3e5ec7347"))
  (text "O1 150R terminator, and the Gotek has no pull-up on its select lines." (at 232 114 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "d282724c-192d-4125-a0dc-6425814ae199"))
  (text "Set the Gotek select jumper to the position that answers the O1 drive-A" (at 232 120 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "c83411a2-83e3-40a7-9ab3-6567fd7c7c74"))
  (text "select (pin 10) - see docs/floppy-adapter-design.md sec. 8." (at 232 126 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "272e6d1d-9124-45c7-b44c-2f1feb4e1e79"))
  (text "Pins 4 (TG43) and 6 (EARLY) carry live FDC outputs: pass through, never GND." (at 232 132 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "fb138729-059c-499b-9923-04c6b4f3d9ee"))
  (text "GND/+5V/+12V are wired like any other net, with one power symbol per rail." (at 232 138 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "ad5ed3e6-af26-49f7-8df5-b07b4d5b2ed1"))
